---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getTsukinamiEvents,
  type TsukinamiEvent,
} from '../lib/notion';
import { createGoogleCalendarUrl } from '../lib/calendar';
import {
  getEventMeta,
  type EventType,
} from '../data/eventMeta';

const events = await getTsukinamiEvents();

/* =========================
   SCHEDULE TYPE
========================= */

type ScheduleType =
  | EventType
  | 'TICKET'
  | 'UNCLASSIFIED';

type ScheduleItem = {
  id: string;

  date: string;
  type: ScheduleType;

  title: string;

  venue?: string;
  time?: string;

  url?: string;

  ticketStart?: string;
  ticketTime?: string;
  ticketUrl?: string;

  isTicket: boolean;

  sourceEvent?: TsukinamiEvent;
};

/* =========================
   TODAY / JST
========================= */

const getTodayJST = () => {
  const parts = new Intl.DateTimeFormat(
    'en-US',
    {
      timeZone: 'Asia/Tokyo',
      year: 'numeric',
      month: '2-digit',
      day: '2-digit',
    }
  ).formatToParts(new Date());

  const year =
    parts.find(
      (part) => part.type === 'year'
    )?.value;

  const month =
    parts.find(
      (part) => part.type === 'month'
    )?.value;

  const day =
    parts.find(
      (part) => part.type === 'day'
    )?.value;

  return `${year}-${month}-${day}`;
};

const today = getTodayJST();

/* =========================
   TICKET DATE / TIME
========================= */

const getTicketDateTimeJST = (
  ticketStart: string
) => {
  const parts =
    new Intl.DateTimeFormat(
      'en-US',
      {
        timeZone: 'Asia/Tokyo',

        year: 'numeric',
        month: '2-digit',
        day: '2-digit',

        hour: '2-digit',
        minute: '2-digit',

        hour12: false,
      }
    ).formatToParts(
      new Date(ticketStart)
    );

  const year =
    parts.find(
      (part) => part.type === 'year'
    )?.value ?? '';

  const month =
    parts.find(
      (part) => part.type === 'month'
    )?.value ?? '';

  const day =
    parts.find(
      (part) => part.type === 'day'
    )?.value ?? '';

  const hour =
    parts.find(
      (part) => part.type === 'hour'
    )?.value ?? '';

  const minute =
    parts.find(
      (part) => part.type === 'minute'
    )?.value ?? '';

  return {
    date: `${year}-${month}-${day}`,
    time: `${hour}:${minute}`,
  };
};

/* =========================
   NOTION EVENTS
   +
   EVENT META
   ↓
   DISPLAY SCHEDULE
========================= */

const scheduleItems: ScheduleItem[] =
  events
    .flatMap(
      (
        event,
        index
      ): ScheduleItem[] => {

        /*
          照合はNotion上の
          元タイトルで行う
        */
        const meta =
          getEventMeta(
            event.date,
            event.title
          );

        /*
          サイト上の表示タイトル
        */
        const displayTitle =
          meta.displayTitle ??
          event.title;

        /*
          通常イベント
        */
        const items: ScheduleItem[] = [
          {
            id: `event-${index}`,

            date:
              event.date,

            type:
              meta.type ??
              'UNCLASSIFIED',

            title:
              displayTitle,

            venue:
              event.venue,

            time:
              event.time,

            url:
              event.url,

            ticketStart:
              meta.ticketStart,

            ticketUrl:
              meta.ticketUrl,

            isTicket:
              false,

            sourceEvent:
              event,
          },
        ];

        /*
          チケ発を独立した予定として追加
        */
        if (meta.ticketStart) {
          const ticketDateTime =
            getTicketDateTimeJST(
              meta.ticketStart
            );

          items.push({
            id:
              `ticket-${index}`,

            date:
              ticketDateTime.date,

            type:
              'TICKET',

            title:
              displayTitle,

            ticketStart:
              meta.ticketStart,

            ticketTime:
              ticketDateTime.time,

            ticketUrl:
              meta.ticketUrl,

            url:
              meta.ticketUrl ||
              event.url,

            isTicket:
              true,
          });
        }

        return items;
      }
    )
    .filter(
      (item) =>
        Boolean(item.date)
    )
    .sort(
      (a, b) =>
        a.date.localeCompare(
          b.date
        )
    );

/* =========================
   UPCOMING / PAST
========================= */

const upcomingItems =
  scheduleItems.filter(
    (item) =>
      item.date >= today
  );

const pastItems =
  scheduleItems
    .filter(
      (item) =>
        item.date < today
    )
    .reverse();

/* =========================
   DATE FORMAT
========================= */

const formatDate = (
  dateString: string
) => {
  const [
    year,
    month,
    day,
  ] = dateString
    .split('-')
    .map(Number);

  const weekdays = [
    'SUN',
    'MON',
    'TUE',
    'WED',
    'THU',
    'FRI',
    'SAT',
  ];

  const weekdayIndex =
    new Date(
      Date.UTC(
        year,
        month - 1,
        day
      )
    ).getUTCDay();

  return {
    date:
      `${String(month).padStart(2, '0')}.` +
      `${String(day).padStart(2, '0')}`,

    weekday:
      weekdays[
        weekdayIndex
      ],
  };
};

/* =========================
   TYPE LABEL
========================= */

const getTypeLabel = (
  type: ScheduleType
) => {
  switch (type) {
    case 'LIVE':
      return 'ライブ';

    case 'EVENT':
      return 'イベント';

    case 'TICKET':
      return 'チケ発';

    default:
      return null;
  }
};

/* =========================
   GOOGLE MAPS
========================= */

const createGoogleMapsUrl = (
  venue: string
) => {
  return (
    'https://www.google.com/maps/search/?api=1&query=' +
    encodeURIComponent(
      venue
    )
  );
};

/* =========================
   GOOGLE CALENDAR
========================= */

const formatGoogleDate = (
  date: Date
) => {
  return date
    .toISOString()
    .replace(
      /[-:]/g,
      ''
    )
    .replace(
      /\.\d{3}/,
      ''
    );
};

const createScheduleCalendarUrl = (
  item: ScheduleItem
) => {

  /* =====================
     TICKET
  ===================== */

  if (item.isTicket) {

    if (!item.ticketStart) {
      return null;
    }

    const startDate =
      new Date(
        item.ticketStart
      );

    const endDate =
      new Date(
        startDate.getTime() +
        60 *
          60 *
          1000
      );

    const description = [
      item.ticketTime
        ? `チケット発売 ${item.ticketTime}`
        : 'チケット発売',

      '',

      '※カレンダー上の終了時刻は便宜上、発売開始から1時間後に設定しています。',

      item.url
        ? `\nチケット情報：\n${item.url}`
        : null,
    ]
      .filter(Boolean)
      .join('\n');

    const params =
      new URLSearchParams({
        action:
          'TEMPLATE',

        text:
          `【チケ発】${item.title}`,

        dates:
          `${formatGoogleDate(startDate)}` +
          `/${formatGoogleDate(endDate)}`,

        details:
          description,
      });

    return (
      'https://calendar.google.com/calendar/render?' +
      params.toString()
    );
  }

  /* =====================
     EVENT / LIVE
  ===================== */

  if (!item.sourceEvent) {
    return null;
  }

  return createGoogleCalendarUrl(
    item.sourceEvent
  );
};

/* =========================
   CALENDAR DATA
========================= */

const calendarItems =
  scheduleItems.map(
    (item) => ({
      date:
        item.date,

      type:
        item.type,
    })
  );

const firstCalendarDate =
  upcomingItems[0]?.date ||
  today;

const [
  initialYear,
  initialMonth,
] = firstCalendarDate
  .split('-')
  .map(Number);
---

<BaseLayout
  title="ツキナミ スケジュール｜ライブ・イベント・チケット情報"
  description="6人組アイドルグループ「ツキナミ」のライブ・イベントスケジュール。出演予定、会場、開演時間、チケット発売情報・購入リンクをまとめています。"
>

  <main class="schedule-page">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <header class="page-header">
      <h1>SCHEDULE</h1>

      <p class="page-description">
        ツキナミのライブ・イベント、チケット発売情報を掲載しています。
      </p>
    </header>

    <!-- =========================
         CALENDAR + LIST
    ========================== -->

    <div class="schedule-layout">

      <!-- =====================
           FILTER + CALENDAR
      ====================== -->

      <aside class="calendar-area">

        <!-- =====================
             FILTER
        ====================== -->

        <div class="schedule-filter">

          <button
            class="filter-button active"
            type="button"
            data-filter="ALL"
          >
            ALL
          </button>

          <button
            class="filter-button"
            type="button"
            data-filter="EVENT"
          >
            イベント
          </button>

          <button
            class="filter-button"
            type="button"
            data-filter="LIVE"
          >
            ライブ
          </button>

          <button
            class="filter-button"
            type="button"
            data-filter="TICKET"
          >
            チケ発
          </button>

        </div>

        <div class="calendar">

          <div class="calendar-header">

            <button
              class="month-button"
              type="button"
              id="prev-month"
              aria-label="前の月"
            >
              ‹
            </button>

            <div class="calendar-month">

              <strong
                id="calendar-month-number"
              >
                {initialMonth}
              </strong>

              <div>
                <span
                  id="calendar-month-name"
                ></span>

                <small
                  id="calendar-year"
                >
                  {initialYear}
                </small>
              </div>

            </div>

            <button
              class="month-button"
              type="button"
              id="next-month"
              aria-label="次の月"
            >
              ›
            </button>

          </div>

          <div class="calendar-weekdays">
            <span>SUN</span>
            <span>MON</span>
            <span>TUE</span>
            <span>WED</span>
            <span>THU</span>
            <span>FRI</span>
            <span>SAT</span>
          </div>

          <div
            class="calendar-days"
            id="calendar-days"
          ></div>

        </div>

      </aside>

      <!-- =====================
           EVENT LIST
      ====================== -->

      <div class="schedule-content">

        <!-- =====================
             UPCOMING
        ====================== -->

        <section
          class="schedule-section"
          id="upcoming-section"
        >

          <div class="section-heading">

            <p>UPCOMING</p>

            <span
              id="upcoming-count"
            >
              {upcomingItems.length} EVENTS
            </span>

          </div>

          <div class="schedule-list">

            {
              upcomingItems.map(
                (item) => {

                  const formatted =
                    formatDate(
                      item.date
                    );

                  const calendarUrl =
                    createScheduleCalendarUrl(
                      item
                    );

                  const mapUrl =
                    item.venue
                      ? createGoogleMapsUrl(
                          item.venue
                        )
                      : null;

                  const typeLabel =
                    getTypeLabel(
                      item.type
                    );

                  const hasTicketPurchase =
                    !item.isTicket &&
                    (
                      item.type === 'LIVE' ||
                      item.type === 'EVENT'
                    ) &&
                    Boolean(item.ticketStart) &&
                    Boolean(item.ticketUrl);

                  return (
                    <article
                      id={item.id}
                      class="schedule-item"
                      data-type={item.type}
                      data-date={item.date}
                    >

                      <div class="date">

                        <span class="date-main">
                          {formatted.date}
                        </span>

                        <span class="date-weekday">
                          {formatted.weekday}
                        </span>

                      </div>

                      <div class="event-info">

                        {typeLabel && (
                          <span
                            class={`event-tag tag-${item.type.toLowerCase()}`}
                          >
                            {typeLabel}
                          </span>
                        )}

                        <h2>
                          {item.title}
                        </h2>

                        <div class="event-meta">

                          {
                            item.isTicket ? (

                              item.ticketTime && (
                                <p>
                                  <span>
                                    TIME
                                  </span>

                                  発売 {item.ticketTime}
                                </p>
                              )

                            ) : (

                              <>

                                {item.venue && (
                                  <div class="venue-row">

                                    <p>
                                      <span>
                                        VENUE
                                      </span>

                                      {item.venue}
                                    </p>

                                    {mapUrl && (
                                      <a
                                        class="map-link"
                                        href={mapUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        title="Google Mapsで開く"
                                        aria-label={`${item.venue}をGoogle Mapsで開く`}
                                      >
                                        <img
                                          src="/images/icons/googlemaps.svg"
                                          alt=""
                                        />

                                        <span>
                                          MAP
                                        </span>
                                      </a>
                                    )}

                                  </div>
                                )}

                                {item.time && (
                                  <p>
                                    <span>
                                      TIME
                                    </span>

                                    {item.time}
                                  </p>
                                )}

                              </>

                            )
                          }

                        </div>

                        {item.url && (
                          <a
                            class="official-link"
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {
                              item.isTicket
                                ? 'チケット情報 →'
                                : '公式情報 →'
                            }
                          </a>
                        )}

                      </div>

                      {(hasTicketPurchase || calendarUrl) && (
                        <div class="calendar-action">

                          {hasTicketPurchase && (
                            <a
                              class="ticket-link ticket-purchase"
                              href={item.ticketUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              title="チケットを購入"
                              data-ticket-start={item.ticketStart}
                              hidden
                            >
                              <img
                                src="/images/icons/ticket.svg"
                                alt=""
                              />

                              <span>
                                購入
                              </span>
                            </a>
                          )}

                          {calendarUrl && (
                            <a
                              class="calendar-link"
                              href={calendarUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              title="Google Calendarに追加"
                            >
                              <img
                                src="/images/icons/googlecalendar.svg"
                                alt=""
                              />

                              <span>
                                追加
                              </span>
                            </a>
                          )}

                        </div>
                      )}

                    </article>
                  );
                }
              )
            }

          </div>

        </section>

        <!-- =====================
             PAST
        ====================== -->

        <section
          class="schedule-section past"
          id="past-section"
        >

          <div class="section-heading">

            <p>PAST</p>

            <span
              id="past-count"
            >
              {pastItems.length} EVENTS
            </span>

          </div>

          <div class="schedule-list">

            {
              pastItems.map(
                (item) => {

                  const formatted =
                    formatDate(
                      item.date
                    );

                  const typeLabel =
                    getTypeLabel(
                      item.type
                    );

                  return (
                    <article
                      id={item.id}
                      class="schedule-item past-item"
                      data-type={item.type}
                      data-date={item.date}
                    >

                      <div class="date">

                        <span class="date-main">
                          {formatted.date}
                        </span>

                        <span class="date-weekday">
                          {formatted.weekday}
                        </span>

                      </div>

                      <div class="event-info">

                        {typeLabel && (
                          <span
                            class={`event-tag tag-${item.type.toLowerCase()}`}
                          >
                            {typeLabel}
                          </span>
                        )}

                        <h2>
                          {item.title}
                        </h2>

                        <div class="event-meta">

                          {
                            item.isTicket ? (

                              item.ticketTime && (
                                <p>
                                  <span>
                                    TIME
                                  </span>

                                  発売 {item.ticketTime}
                                </p>
                              )

                            ) : (

                              <>

                                {item.venue && (
                                  <p>
                                    <span>
                                      VENUE
                                    </span>

                                    {item.venue}
                                  </p>
                                )}

                                {item.time && (
                                  <p>
                                    <span>
                                      TIME
                                    </span>

                                    {item.time}
                                  </p>
                                )}

                              </>

                            )
                          }

                        </div>

                        {item.url && (
                          <a
                            class="official-link"
                            href={item.url}
                            target="_blank"
                            rel="noopener noreferrer"
                          >
                            {
                              item.isTicket
                                ? 'チケット情報 →'
                                : '公式情報 →'
                            }
                          </a>
                        )}

                      </div>

                    </article>
                  );
                }
              )
            }

          </div>

        </section>

      </div>

    </div>

  </main>

</BaseLayout>

<script
  define:vars={{
    calendarItems,
    initialYear,
    initialMonth,
    today,
  }}
>
  const monthNames = [
    'JANUARY',
    'FEBRUARY',
    'MARCH',
    'APRIL',
    'MAY',
    'JUNE',
    'JULY',
    'AUGUST',
    'SEPTEMBER',
    'OCTOBER',
    'NOVEMBER',
    'DECEMBER',
  ];

  let displayYear =
    initialYear;

  let displayMonth =
    initialMonth;

  let currentFilter =
    'ALL';

  const daysContainer =
    document.getElementById(
      'calendar-days'
    );

  const monthNumber =
    document.getElementById(
      'calendar-month-number'
    );

  const monthName =
    document.getElementById(
      'calendar-month-name'
    );

  const yearLabel =
    document.getElementById(
      'calendar-year'
    );

  const filterButtons =
    document.querySelectorAll(
      '.filter-button'
    );

  const scheduleElements =
    document.querySelectorAll(
      '.schedule-item'
    );

  const upcomingSection =
    document.getElementById(
      'upcoming-section'
    );

  const pastSection =
    document.getElementById(
      'past-section'
    );

  const upcomingCount =
    document.getElementById(
      'upcoming-count'
    );

  const pastCount =
    document.getElementById(
      'past-count'
    );

  const pad = (number) =>
    String(number).padStart(
      2,
      '0'
    );

  /* =========================
     TICKET PURCHASE
  ========================= */

  const ticketPurchaseLinks =
    document.querySelectorAll(
      '.ticket-purchase'
    );

  const updateTicketPurchaseLinks =
    () => {

      const now =
        Date.now();

      let nextStartTime =
        Infinity;

      ticketPurchaseLinks.forEach(
        (link) => {

          const ticketStart =
            link.dataset
              .ticketStart;

          if (!ticketStart) {
            link.hidden = true;
            return;
          }

          const startTime =
            new Date(
              ticketStart
            ).getTime();

          if (
            Number.isNaN(
              startTime
            )
          ) {
            link.hidden = true;
            return;
          }

          const isOnSale =
            now >= startTime;

          link.hidden =
            !isOnSale;

          if (
            !isOnSale &&
            startTime < nextStartTime
          ) {
            nextStartTime =
              startTime;
          }
        }
      );

      if (
        Number.isFinite(
          nextStartTime
        )
      ) {
        const maxDelay =
          2147483000;

        const delay =
          Math.min(
            Math.max(
              nextStartTime -
                now +
                100,
              100
            ),
            maxDelay
          );

        window.setTimeout(
          updateTicketPurchaseLinks,
          delay
        );
      }
    };

  /* =========================
     FILTERED CALENDAR DATA
  ========================= */

  const getFilteredCalendarItems =
    () => {
      return calendarItems.filter(
        (item) =>
          currentFilter ===
            'ALL' ||
          item.type ===
            currentFilter
      );
    };

  /* =========================
     CALENDAR
  ========================= */

  const renderCalendar =
    () => {

      if (!daysContainer) {
        return;
      }

      daysContainer.innerHTML =
        '';

      if (monthNumber) {
        monthNumber.textContent =
          displayMonth;
      }

      if (monthName) {
        monthName.textContent =
          monthNames[
            displayMonth - 1
          ];
      }

      if (yearLabel) {
        yearLabel.textContent =
          displayYear;
      }

      const firstDay =
        new Date(
          Date.UTC(
            displayYear,
            displayMonth - 1,
            1
          )
        ).getUTCDay();

      const daysInMonth =
        new Date(
          Date.UTC(
            displayYear,
            displayMonth,
            0
          )
        ).getUTCDate();

      const filteredItems =
        getFilteredCalendarItems();

      const activeDates =
        new Set(
          filteredItems.map(
            (item) =>
              item.date
          )
        );

      /*
        月初までの空白
      */
      for (
        let i = 0;
        i < firstDay;
        i++
      ) {
        const blank =
          document.createElement(
            'span'
          );

        blank.className =
          'calendar-day blank';

        daysContainer.appendChild(
          blank
        );
      }

      /*
        日付
      */
      for (
        let day = 1;
        day <= daysInMonth;
        day++
      ) {

        const date =
          `${displayYear}-` +
          `${pad(displayMonth)}-` +
          `${pad(day)}`;

        const hasSchedule =
          activeDates.has(
            date
          );

        const isToday =
          date === today;

        const element =
          document.createElement(
            hasSchedule
              ? 'button'
              : 'span'
          );

        element.className =
          'calendar-day';

        element.textContent =
          day;

        /*
          今日
        */
        if (isToday) {
          element.classList.add(
            'is-today'
          );
        }

        /*
          予定あり
        */
        if (hasSchedule) {

          element.classList.add(
            'has-schedule'
          );

          element.type =
            'button';

          element.setAttribute(
            'aria-label',
            isToday
              ? `本日 ${date} の予定を見る`
              : `${date}の予定を見る`
          );

          element.addEventListener(
            'click',
            () => {

              const targets =
                [
                  ...scheduleElements,
                ].filter(
                  (item) =>
                    !item.hidden &&
                    item.dataset.date ===
                      date
                );

              const target =
                targets[0];

              if (!target) {
                return;
              }

              target.scrollIntoView({
                behavior:
                  'smooth',

                block:
                  'start',
              });

              target.classList.remove(
                'schedule-highlight'
              );

              void target.offsetWidth;

              target.classList.add(
                'schedule-highlight'
              );
            }
          );
        }

        daysContainer.appendChild(
          element
        );
      }
    };

  /* =========================
     FILTER
  ========================= */

  const updateSections =
    () => {

      let upcomingVisible =
        0;

      let pastVisible =
        0;

      scheduleElements.forEach(
        (item) => {

          const matches =
            currentFilter ===
              'ALL' ||
            item.dataset.type ===
              currentFilter;

          item.hidden =
            !matches;

          if (!matches) {
            return;
          }

          if (
            item.closest(
              '#upcoming-section'
            )
          ) {
            upcomingVisible++;
          }

          if (
            item.closest(
              '#past-section'
            )
          ) {
            pastVisible++;
          }
        }
      );

      if (upcomingCount) {
        upcomingCount.textContent =
          `${upcomingVisible} EVENTS`;
      }

      if (pastCount) {
        pastCount.textContent =
          `${pastVisible} EVENTS`;
      }

      if (upcomingSection) {
        upcomingSection.hidden =
          upcomingVisible === 0;
      }

      if (pastSection) {
        pastSection.hidden =
          pastVisible === 0;
      }
    };

  filterButtons.forEach(
    (button) => {

      button.addEventListener(
        'click',
        () => {

          currentFilter =
            button.dataset
              .filter ||
            'ALL';

          filterButtons.forEach(
            (item) =>
              item.classList.remove(
                'active'
              )
          );

          button.classList.add(
            'active'
          );

          updateSections();

          renderCalendar();
        }
      );
    }
  );

  /* =========================
     PREVIOUS MONTH
  ========================= */

  document
    .getElementById(
      'prev-month'
    )
    ?.addEventListener(
      'click',
      () => {

        displayMonth--;

        if (
          displayMonth < 1
        ) {
          displayMonth = 12;
          displayYear--;
        }

        renderCalendar();
      }
    );

  /* =========================
     NEXT MONTH
  ========================= */

  document
    .getElementById(
      'next-month'
    )
    ?.addEventListener(
      'click',
      () => {

        displayMonth++;

        if (
          displayMonth > 12
        ) {
          displayMonth = 1;
          displayYear++;
        }

        renderCalendar();
      }
    );

  updateTicketPurchaseLinks();

  updateSections();

  renderCalendar();
</script>

