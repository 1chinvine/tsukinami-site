---
import BaseLayout from '../layouts/BaseLayout.astro';
import { members } from '../data/members';
import SocialIcons from '../components/SocialIcons.astro';
---

<BaseLayout title="MEMBER | ツキナミ">
  <main class="member-page">
    <h1>MEMBER</h1>

    <div class="member-grid">
      {
        members.map((member) => (
          <article class="member-card">

            <!-- 写真・名前をクリックすると個人ページへ -->
            <a
              class="member-main"
              href={`/member/${member.slug}`}
            >
              <div class="member-image">
                <img
                  src={member.image}
                  alt={member.name}
                />

                {member.role && (
                  <span class="member-role">
                    {member.role}
                  </span>
                )}
              </div>

              <h2>{member.name}</h2>

              <p class="member-name-en">
                {member.nameEn}
              </p>
            </a>

            <!-- SNS -->
            <div class="member-sns">
              <SocialIcons
                sns={member.sns}
                name={member.name}
              />
            </div>

          </article>
        ))
      }
    </div>
  </main>
</BaseLayout>

<style>
  /* =========================
     PAGE
  ========================= */

  .member-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 40px 84px;
  }

  h1 {
    margin: 0 0 48px;

    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
    font-weight: 600;
  }

  /* =========================
     MEMBER GRID
  ========================= */

  .member-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 56px 32px;
  }

  .member-card {
    min-width: 0;
  }

  /* =========================
     MEMBER
  ========================= */

  .member-main {
    display: block;

    color: var(--text);
    text-decoration: none;
  }

  /* =========================
     PHOTO
  ========================= */

  .member-image {
    position: relative;

    width: 100%;
    aspect-ratio: 3 / 4;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.06);
  }

  .member-image img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.3s ease;
  }

  .member-main:hover .member-image img {
    transform: scale(1.03);
  }

  /* =========================
     ROLE
  ========================= */

  .member-role {
    position: absolute;
    left: 50%;
    bottom: 14px;

    transform: translateX(-50%);

    padding: 5px 14px;

    background: rgba(255, 255, 255, 0.92);
    color: #111;

    border-radius: 999px;

    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;

    white-space: nowrap;
  }

  /* =========================
     NAME
  ========================= */

  h2 {
    margin: 14px 0 0;

    font-size: 20px;
    line-height: 1.3;
    font-weight: 600;
  }

  /* =========================
     ROMAJI
  ========================= */

  .member-name-en {
    margin: 3px 0 0;

    color: var(--muted);

    font-size: 8px;
    line-height: 1.2;
    letter-spacing: 0.1em;
  }

  /* =========================
     SNS
  ========================= */

  .member-sns {
    margin-top: 8px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {
    .member-page {
      padding: 40px 20px 52px;
    }

    h1 {
      margin-bottom: 28px;
      font-size: 32px;
    }

    /* 2人ずつ表示 */

    .member-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 30px 14px;
    }

    .member-image {
      aspect-ratio: 3 / 4;
    }

    /* ROLE */

    .member-role {
      bottom: 8px;

      padding: 3px 8px;

      font-size: 7px;
    }

    /* NAME */

    h2 {
      margin-top: 10px;

      font-size: 14px;
      line-height: 1.3;
    }

    /* ROMAJI */

    .member-name-en {
      margin-top: 2px;

      font-size: 7px;
      line-height: 1.2;
      letter-spacing: 0.08em;
    }

    /* SNS */

    .member-sns {
      margin-top: 6px;
    }
  }
</style>