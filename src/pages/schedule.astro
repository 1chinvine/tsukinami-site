---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTsukinamiEvents } from '../lib/notion';
import { createGoogleCalendarUrl } from '../lib/calendar';

const events = await getTsukinamiEvents();

const today = new Date();
today.setHours(0, 0, 0, 0);

const formatDate = (dateString: string) => {
  const date = new Date(`${dateString}T00:00:00`);

  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');

  const weekdays = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];

  return {
    date: `${month}.${day}`,
    weekday: weekdays[date.getDay()],
  };
};

const upcomingEvents = events
  .filter((event) => {
    if (!event.date) return false;

    const eventDate = new Date(`${event.date}T00:00:00`);
    return eventDate >= today;
  })
  .sort((a, b) => a.date.localeCompare(b.date));

const pastEvents = events
  .filter((event) => {
    if (!event.date) return false;

    const eventDate = new Date(`${event.date}T00:00:00`);
    return eventDate < today;
  })
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="SCHEDULE | ツキナミ">
  <main class="schedule-page">
    <h1>SCHEDULE</h1>

    <section class="schedule-section">
      <div class="section-heading">
        <p>UPCOMING</p>
        <span>{upcomingEvents.length} EVENTS</span>
      </div>

      <div class="schedule-list">
        {
          upcomingEvents.map((event) => {
            const formatted = formatDate(event.date);
            const calendarUrl = createGoogleCalendarUrl(event);

            return (
              <article class="schedule-item">
                <div class="date">
                  <span class="date-main">{formatted.date}</span>
                  <span class="date-weekday">{formatted.weekday}</span>
                </div>

                <div class="event-info">
                  <h2>{event.title}</h2>

                  <div class="event-meta">
                    {event.venue && (
                      <p>
                        <span>VENUE</span>
                        {event.venue}
                      </p>
                    )}

                    {event.time && (
                      <p>
                        <span>TIME</span>
                        {event.time}
                      </p>
                    )}
                  </div>

                  {event.url && (
                    <a
                      class="official-link"
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      公式情報 →
                    </a>
                  )}
                </div>

                {calendarUrl && (
                  <div class="calendar-action">
                    <a
                      class="calendar-link"
                      href={calendarUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${event.title}をGoogleカレンダーに追加`}
                      title="Google Calendarに追加"
                    >
                      <img
                        src="/images/icons/googlecalendar.svg"
                        alt=""
                      />
                      <span>追加</span>
                    </a>
                  </div>
                )}
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="schedule-section past">
      <div class="section-heading">
        <p>PAST</p>
        <span>{pastEvents.length} EVENTS</span>
      </div>

      <div class="schedule-list">
        {
          pastEvents.map((event) => {
            const formatted = formatDate(event.date);

            return (
              <article class="schedule-item past-item">
                <div class="date">
                  <span class="date-main">{formatted.date}</span>
                  <span class="date-weekday">{formatted.weekday}</span>
                </div>

                <div class="event-info">
                  <h2>{event.title}</h2>

                  <div class="event-meta">
                    {event.venue && (
                      <p>
                        <span>VENUE</span>
                        {event.venue}
                      </p>
                    )}

                    {event.time && (
                      <p>
                        <span>TIME</span>
                        {event.time}
                      </p>
                    )}
                  </div>

                  {event.url && (
                    <a
                      class="official-link"
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      公式情報 →
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .schedule-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 40px 84px;
  }

  h1 {
    margin: 8px 0 48px;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
    font-weight: 600;
  }

  .schedule-section {
    margin-bottom: 72px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .section-heading p {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.1em;
  }

  .section-heading span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .schedule-list {
    border-top: 1px solid var(--line);
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr) auto;
    gap: 36px;
    align-items: center;

    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .past-item {
    grid-template-columns: 130px minmax(0, 1fr);
  }

  .date {
    display: flex;
    flex-direction: column;
    align-self: start;
  }

  .date-main {
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .date-weekday {
    margin-top: 7px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .event-info {
    min-width: 0;
  }

  .event-info h2 {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 500;
  }

  .event-meta {
    margin-top: 12px;
  }

  .event-meta p {
    margin: 5px 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .event-meta span {
    display: inline-block;
    width: 56px;
    color: var(--accent);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .official-link {
    display: inline-block;

    margin-top: 10px;
    padding-bottom: 3px;

    color: var(--text);
    font-size: 10px;
    text-decoration: none;

    border-bottom: 1px solid var(--line);
  }

  .official-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* =========================
     GOOGLE CALENDAR
  ========================= */

  .calendar-action {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    min-width: 102px;
  }

  .calendar-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;

    min-width: 96px;
    height: 42px;

    padding: 0 15px;

    color: var(--text);

    font-size: 11px;
    letter-spacing: 0.08em;

    text-decoration: none;

    border: 1px solid var(--line);
    border-radius: 22px;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .calendar-link img {
    display: block;

    width: 20px;
    height: 20px;

    object-fit: contain;

    /* 黒SVG → 白 */
    filter: invert(1);
  }

  .calendar-link span {
    white-space: nowrap;
  }

  .calendar-link:hover {
    color: var(--accent);

    border-color: var(--accent);

    background: rgba(255, 255, 255, 0.04);

    transform: translateY(-1px);
  }

  .past {
    opacity: 0.55;
  }

  .past .date-weekday {
    color: var(--muted);
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {
    .schedule-page {
      padding: 40px 20px 52px;
    }

    h1 {
      margin: 6px 0 32px;
      font-size: 32px;
    }

    .schedule-section {
      margin-bottom: 48px;
    }

    .section-heading {
      margin-bottom: 10px;
    }

    .section-heading p {
      font-size: 12px;
    }

    .section-heading span {
      font-size: 8px;
    }

    .schedule-item,
    .past-item {
      grid-template-columns: 1fr;
      gap: 8px;

      padding: 16px 0;
    }

    .date-main {
      font-size: 20px;
    }

    .date-weekday {
      margin-top: 5px;
      font-size: 8px;
    }

    .event-info h2 {
      font-size: 14px;
      line-height: 1.4;
    }

    .event-meta {
      margin-top: 8px;
    }

    .event-meta p {
      margin: 3px 0;
      font-size: 9px;
    }

    .event-meta span {
      width: 48px;
      font-size: 7px;
    }

    .official-link {
      margin-top: 7px;
      font-size: 8px;
    }

    .calendar-action {
      min-width: 0;

      margin-top: 5px;

      justify-content: flex-end;
    }

    .calendar-link {
      min-width: 86px;
      height: 38px;

      gap: 7px;

      padding: 0 13px;

      font-size: 10px;
    }

    .calendar-link img {
      width: 18px;
      height: 18px;
    }
  }
</style>