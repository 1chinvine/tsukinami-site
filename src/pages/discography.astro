---
import BaseLayout from '../layouts/BaseLayout.astro';
import { discography } from '../data/discography';
---

<BaseLayout
  title="ツキナミ ディスコグラフィー｜楽曲・リリース情報"
  description="6人組アイドルグループ「ツキナミ」のディスコグラフィー。楽曲、シングル、リリース情報、配信リンクを掲載しています。"
>
  <main class="page">

    <h1>DISCOGRAPHY</h1>

    <p class="page-description">
      ツキナミの楽曲・リリース情報を掲載しています。
    </p>

    <div class="discography-grid">
      {
        discography.map((release) => (
          <article class="discography-item">

            <!-- =========================
                 JACKET
            ========================= -->

            <div class="cover">
              <img
                src={release.image}
                alt={`ツキナミ「${release.title}」ジャケット`}
              />
            </div>

            <!-- =========================
                 TYPE
            ========================= -->

            <p class="type">
              {release.type}
            </p>

            <!-- =========================
                 TITLE + LISTEN
            ========================= -->

            <div class="title-row">
              <h2>{release.title}</h2>

              {release.link && (
                <a
                  class="listen-link"
                  href={release.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${release.title}を聴く`}
                  title="LISTEN"
                >
                  <img
                    src="/images/icons/applemusic.svg"
                    alt=""
                  />
                </a>
              )}
            </div>

            <!-- =========================
                 RELEASE DATE
            ========================= -->

            <p class="release-date">
              {release.releaseDate}
            </p>

          </article>
        ))
      }
    </div>

  </main>
</BaseLayout>

<style>
  /* =========================
     PAGE
  ========================= */

  .page {
    max-width: 1200px;
    margin: 0 auto;

    padding: 100px 40px 120px;
  }

  /* =========================
     PAGE TITLE
  ========================= */

  h1 {
    margin: 8px 0 20px;

    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    font-weight: 600;
  }

  /* =========================
     DESCRIPTION
  ========================= */

  .page-description {
    max-width: 680px;

    margin: 0 0 32px;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.9;
  }

  /* =========================
     GRID
  ========================= */

  .discography-grid {
    display: grid;

    grid-template-columns: repeat(3, 1fr);

    gap: 64px 32px;
  }

  .discography-item {
    min-width: 0;
  }

  /* =========================
     COVER
  ========================= */

  .cover {
    width: 100%;
    aspect-ratio: 1 / 1;

    overflow: hidden;

    background: rgba(255, 255, 255, 0.06);
  }

  .cover img {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transition: transform 0.35s ease;
  }

  .discography-item:hover .cover img {
    transform: scale(1.03);
  }

  /* =========================
     TYPE
  ========================= */

  .type {
    margin: 16px 0 6px;

    color: var(--accent);

    font-size: 11px;
    letter-spacing: 0.18em;
  }

  /* =========================
     TITLE
  ========================= */

  .title-row {
    display: flex;

    align-items: center;

    gap: 10px;
  }

  h2 {
    margin: 0;

    font-size: 22px;
    line-height: 1.4;
    font-weight: 500;
  }

  /* =========================
     LISTEN ICON
  ========================= */

  .listen-link {
    display: grid;

    place-items: center;

    width: 17px;
    height: 17px;

    flex: 0 0 auto;
  }

  .listen-link img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: contain;

  filter: brightness(0) invert(1);
  opacity: 0.7;

  transition:
    opacity 0.2s ease,
    transform 0.2s ease;
}

.listen-link:hover img {
  opacity: 1;
  transform: scale(1.08);
}

  /* =========================
     RELEASE DATE
  ========================= */

  .release-date {
    margin: 10px 0 0;

    color: var(--muted);

    font-size: 11px;
    letter-spacing: 0.08em;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .page {
      padding: 40px 20px 52px;
    }

    /* =========================
       PAGE TITLE
    ========================= */

    h1 {
      margin: 0 0 14px;

      font-size: 32px;
    }

    /* =========================
       DESCRIPTION
    ========================= */

    .page-description {
      margin-bottom: 32px;

      font-size: 11px;
      line-height: 1.8;
    }

    /* =========================
       GRID
    ========================= */

    .discography-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 36px 14px;
    }

    /* =========================
       TYPE
    ========================= */

    .type {
      margin: 10px 0 4px;

      font-size: 8px;
    }

    /* =========================
       TITLE
    ========================= */

    .title-row {
      gap: 6px;
    }

    h2 {
      font-size: 14px;
      line-height: 1.4;
    }

    /* =========================
       LISTEN ICON
    ========================= */

    .listen-link {
      width: 14px;
      height: 14px;
    }

    /* =========================
       RELEASE DATE
    ========================= */

    .release-date {
      margin-top: 7px;

      font-size: 8px;
    }
  }
</style>