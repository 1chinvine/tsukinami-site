---
import { getTsukinamiEvents } from '../lib/notion';

const events = await getTsukinamiEvents();

/*
  現在の日付を日本時間（Asia/Tokyo）で
  YYYY-MM-DD形式にする
*/
const getTodayJST = () => {
  const parts = new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  }).formatToParts(new Date());

  const year = parts.find((part) => part.type === 'year')?.value;
  const month = parts.find((part) => part.type === 'month')?.value;
  const day = parts.find((part) => part.type === 'day')?.value;

  return `${year}-${month}-${day}`;
};

const today = getTodayJST();

/*
  今日以降かつ「予定」のイベントから
  最も近い1件を取得
*/
const nextEvent = events
  .filter((event) => {
    if (event.status !== '予定') return false;
    if (!event.date) return false;

    return event.date >= today;
  })
  .sort((a, b) => a.date.localeCompare(b.date))[0];

/*
  表示用の日付
  YYYY-MM-DDを直接分解することで
  実行環境のタイムゾーンによる日付ズレを防ぐ
*/
const formatDate = (dateString: string) => {
  const [year, month, day] = dateString
    .split('-')
    .map(Number);

  const weekdays = [
    'SUN',
    'MON',
    'TUE',
    'WED',
    'THU',
    'FRI',
    'SAT',
  ];

  const weekdayIndex = new Date(
    Date.UTC(year, month - 1, day)
  ).getUTCDay();

  return {
    date: `${String(month).padStart(2, '0')}.${String(day).padStart(2, '0')}`,
    weekday: weekdays[weekdayIndex],
  };
};

/*
  Google Maps検索URL
*/
const createGoogleMapsUrl = (venue: string) => {
  return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(venue)}`;
};

const formattedDate = nextEvent
  ? formatDate(nextEvent.date)
  : null;

const mapUrl = nextEvent?.venue
  ? createGoogleMapsUrl(nextEvent.venue)
  : null;
---

<section class="next-schedule">
  <div class="inner">
    <p class="label">SCHEDULE</p>

    <h2>NEXT LIVE</h2>

    {
      nextEvent ? (
        <article class="event">

          <div class="date">
            <span class="date-main">
              {formattedDate?.date}
            </span>

            <span class="date-weekday">
              {formattedDate?.weekday}
            </span>
          </div>

          <div class="event-info">
            <h3>{nextEvent.title}</h3>

            {nextEvent.venue && (
              <div class="venue-row">
                <p>
                  会場：{nextEvent.venue}
                </p>

                {mapUrl && (
                  <a
                    class="map-link"
                    href={mapUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${nextEvent.venue}をGoogle Mapsで開く`}
                    title="Google Mapsで開く"
                  >
                    <img
                      src="/images/icons/googlemaps.svg"
                      alt=""
                    />

                    <span>MAP</span>
                  </a>
                )}
              </div>
            )}

            {nextEvent.time && (
              <p>
                時刻：{nextEvent.time}
              </p>
            )}

            {nextEvent.url && (
              <a
                class="official-link"
                href={nextEvent.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                公式情報 →
              </a>
            )}
          </div>

        </article>
      ) : (
        <p>
          現在予定されているイベントはありません。
        </p>
      )
    }

    <a
      class="view-all"
      href="/schedule"
    >
      VIEW ALL →
    </a>
  </div>
</section>

<style>
  /* =========================
     SECTION
  ========================= */

  .next-schedule {
    padding: 72px 40px 84px;

    border-top: 1px solid var(--line);
  }

  .inner {
    max-width: 1200px;

    margin: 0 auto;
  }

  .label {
    margin: 0;

    font-size: 11px;
    letter-spacing: 0.18em;

    color: var(--muted);
  }

  h2 {
    margin: 10px 0 34px;

    font-size: clamp(36px, 4vw, 54px);
    line-height: 1;
    font-weight: 600;
  }

  /* =========================
     EVENT
  ========================= */

  .event {
    display: grid;

    grid-template-columns: 160px 1fr;

    gap: 48px;

    padding: 28px 0;

    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .event-info {
    min-width: 0;
  }

  /* =========================
     DATE
  ========================= */

  .date {
    display: flex;
    flex-direction: column;

    padding-top: 2px;
  }

  .date-main {
    font-size: 28px;
    font-weight: 500;
    line-height: 1;

    letter-spacing: -0.02em;
  }

  .date-weekday {
    margin-top: 8px;

    font-size: 10px;
    letter-spacing: 0.18em;

    color: var(--accent);
  }

  /* =========================
     EVENT INFORMATION
  ========================= */

  h3 {
    margin: 0 0 12px;

    font-size: 22px;
    line-height: 1.4;
    font-weight: 600;
  }

  .event p {
    margin: 5px 0;

    font-size: 13px;
    line-height: 1.6;

    color: var(--muted);
  }

  /* =========================
     VENUE + MAP
  ========================= */

  .venue-row {
    display: flex;
    align-items: center;

    gap: 12px;

    flex-wrap: wrap;
  }

  .venue-row p {
    margin: 5px 0;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    gap: 6px;

    min-width: 72px;
    height: 30px;

    padding: 0 10px;

    color: var(--text);

    font-size: 9px;
    letter-spacing: 0.08em;

    text-decoration: none;

    border: 1px solid var(--line);
    border-radius: 16px;

    transition:
      border-color 0.2s ease,
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .map-link img {
    display: block;

    width: 12px;
    height: 12px;

    object-fit: contain;

    /* 黒SVG → 白 */
    filter: invert(1);
  }

  .map-link span {
    white-space: nowrap;
  }

  .map-link:hover {
    color: var(--accent);

    border-color: var(--accent);

    background: rgba(255, 255, 255, 0.04);

    transform: translateY(-1px);
  }

  /* =========================
     LINKS
  ========================= */

  .official-link,
  .view-all {
    position: relative;

    display: inline-block;

    color: var(--text);

    font-size: 12px;
    letter-spacing: 0.04em;

    text-decoration: none;
  }

  .official-link {
    margin-top: 12px;
  }

  .view-all {
    margin-top: 28px;
  }

  .official-link::after,
  .view-all::after {
    content: "";

    position: absolute;

    left: 0;
    bottom: -5px;

    width: 100%;
    height: 1px;

    background: var(--accent);
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {
    .next-schedule {
      padding: 44px 20px 56px;
    }

    h2 {
      margin-bottom: 28px;

      font-size: 38px;
    }

    .event {
      grid-template-columns: 1fr;

      gap: 18px;

      padding: 24px 0;
    }

    .date-main {
      font-size: 30px;
    }

    h3 {
      font-size: 19px;
    }

    .venue-row {
      gap: 8px;
    }

    .map-link {
      min-width: 66px;
      height: 28px;

      gap: 5px;

      padding: 0 9px;

      font-size: 8px;
    }

    .map-link img {
      width: 11px;
      height: 11px;
    }

    .view-all {
      margin-top: 24px;
    }
  }
</style>