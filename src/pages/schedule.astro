---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTsukinamiEvents } from '../lib/notion';
import { createGoogleCalendarUrl } from '../lib/calendar';

const events = await getTsukinamiEvents();

const today = new Date();
today.setHours(0, 0, 0, 0);

const formatDate = (dateString: string) => {
  const date = new Date(`${dateString}T00:00:00`);

  const month = String(date.getMonth() + 1).padStart(2, '0');
  const day = String(date.getDate()).padStart(2, '0');

  const weekdays = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];

  return {
    date: `${month}.${day}`,
    weekday: weekdays[date.getDay()],
  };
};

const upcomingEvents = events
  .filter((event) => {
    if (!event.date) return false;

    const eventDate = new Date(`${event.date}T00:00:00`);
    return eventDate >= today;
  })
  .sort((a, b) => a.date.localeCompare(b.date));

const pastEvents = events
  .filter((event) => {
    if (!event.date) return false;

    const eventDate = new Date(`${event.date}T00:00:00`);
    return eventDate < today;
  })
  .sort((a, b) => b.date.localeCompare(a.date));
---

<BaseLayout title="SCHEDULE | ツキナミ">
  <main class="schedule-page">
    <h1>SCHEDULE</h1>

    <section class="schedule-section">
      <div class="section-heading">
        <p>UPCOMING</p>
        <span>{upcomingEvents.length} EVENTS</span>
      </div>

      <div class="schedule-list">
        {
          upcomingEvents.map((event) => {
            const formatted = formatDate(event.date);
            const calendarUrl = createGoogleCalendarUrl(event);

            return (
              <article class="schedule-item">
                <div class="date">
                  <span class="date-main">{formatted.date}</span>
                  <span class="date-weekday">{formatted.weekday}</span>
                </div>

                <div class="event-info">
                  <h2>{event.title}</h2>

                  <div class="event-meta">
                    {event.venue && (
                      <p>
                        <span>VENUE</span>
                        {event.venue}
                      </p>
                    )}

                    {event.time && (
                      <p>
                        <span>TIME</span>
                        {event.time}
                      </p>
                    )}
                  </div>

                  <div class="event-actions">
                    {event.url && (
                      <a
                        class="official-link"
                        href={event.url}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        公式情報 →
                      </a>
                    )}

                    {calendarUrl && (
                      <a
                        class="calendar-link"
                        href={calendarUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${event.title}をGoogleカレンダーに追加`}
                        title="Google Calendarに追加"
                      >
                        <img
                          src="/images/icons/googlecalendar.svg"
                          alt=""
                        />
                      </a>
                    )}
                  </div>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>

    <section class="schedule-section past">
      <div class="section-heading">
        <p>PAST</p>
        <span>{pastEvents.length} EVENTS</span>
      </div>

      <div class="schedule-list">
        {
          pastEvents.map((event) => {
            const formatted = formatDate(event.date);

            return (
              <article class="schedule-item">
                <div class="date">
                  <span class="date-main">{formatted.date}</span>
                  <span class="date-weekday">{formatted.weekday}</span>
                </div>

                <div class="event-info">
                  <h2>{event.title}</h2>

                  <div class="event-meta">
                    {event.venue && (
                      <p>
                        <span>VENUE</span>
                        {event.venue}
                      </p>
                    )}

                    {event.time && (
                      <p>
                        <span>TIME</span>
                        {event.time}
                      </p>
                    )}
                  </div>

                  {event.url && (
                    <a
                      class="official-link"
                      href={event.url}
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      公式情報 →
                    </a>
                  )}
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .schedule-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 72px 40px 84px;
  }

  h1 {
    margin: 8px 0 48px;
    font-size: clamp(36px, 4vw, 52px);
    line-height: 1;
    font-weight: 600;
  }

  .schedule-section {
    margin-bottom: 72px;
  }

  .section-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 16px;
  }

  .section-heading p {
    margin: 0;
    font-size: 15px;
    letter-spacing: 0.1em;
  }

  .section-heading span {
    color: var(--muted);
    font-size: 9px;
    letter-spacing: 0.1em;
  }

  .schedule-list {
    border-top: 1px solid var(--line);
  }

  .schedule-item {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 36px;
    padding: 22px 0;
    border-bottom: 1px solid var(--line);
  }

  .date {
    display: flex;
    flex-direction: column;
  }

  .date-main {
    font-size: 28px;
    line-height: 1;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .date-weekday {
    margin-top: 7px;
    color: var(--accent);
    font-size: 9px;
    letter-spacing: 0.16em;
  }

  .event-info h2 {
    margin: 0;
    font-size: 18px;
    line-height: 1.4;
    font-weight: 500;
  }

  .event-meta {
    margin-top: 12px;
  }

  .event-meta p {
    margin: 5px 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .event-meta span {
    display: inline-block;
    width: 56px;
    color: var(--accent);
    font-size: 8px;
    letter-spacing: 0.1em;
  }

  .event-actions {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 10px;
  }

  .official-link {
    display: inline-block;
    color: var(--text);
    font-size: 10px;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    padding-bottom: 3px;
  }

  .official-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .calendar-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 28px;
    height: 28px;

    opacity: 0.6;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

 .calendar-link img {
  display: block;

  width: 15px;
  height: 15px;

  object-fit: contain;

  /* 黒SVG → 白 */
  filter: invert(1);
}

  .calendar-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  .past {
    opacity: 0.55;
  }

  .past .date-weekday {
    color: var(--muted);
  }

  @media (max-width: 700px) {
    .schedule-page {
      padding: 40px 20px 52px;
    }

    h1 {
      margin: 6px 0 32px;
      font-size: 32px;
    }

    .schedule-section {
      margin-bottom: 48px;
    }

    .section-heading {
      margin-bottom: 10px;
    }

    .section-heading p {
      font-size: 12px;
    }

    .section-heading span {
      font-size: 8px;
    }

    .schedule-item {
      grid-template-columns: 1fr;
      gap: 8px;
      padding: 16px 0;
    }

    .date-main {
      font-size: 20px;
    }

    .date-weekday {
      margin-top: 5px;
      font-size: 8px;
    }

    .event-info h2 {
      font-size: 14px;
      line-height: 1.4;
    }

    .event-meta {
      margin-top: 8px;
    }

    .event-meta p {
      margin: 3px 0;
      font-size: 9px;
    }

    .event-meta span {
      width: 48px;
      font-size: 7px;
    }

    .event-actions {
      gap: 8px;
      margin-top: 6px;
    }

    .official-link {
      font-size: 8px;
    }

    .calendar-link {
      width: 30px;
      height: 30px;
    }

    .calendar-link img {
      width: 14px;
      height: 14px;
    }
  }
</style>