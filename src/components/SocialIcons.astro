---
interface Props {
  sns: {
    x?: string;
    instagram?: string;
    tiktok?: string;
    youtube?: string;
  };

  name?: string;
}

const { sns, name = '' } = Astro.props;
---

<div class="social-icons">
  {
    sns.x && (
      <a
        href={sns.x}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} X`}
      >
        <img src="/images/icons/x.svg" alt="" />
      </a>
    )
  }

  {
    sns.instagram && (
      <a
        href={sns.instagram}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} Instagram`}
      >
        <img src="/images/icons/instagram.svg" alt="" />
      </a>
    )
  }

  {
    sns.tiktok && (
      <a
        href={sns.tiktok}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} TikTok`}
      >
        <img src="/images/icons/tiktok.svg" alt="" />
      </a>
    )
  }

  {
    sns.youtube && (
      <a
        href={sns.youtube}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} YouTube`}
      >
        <img src="/images/icons/youtube.svg" alt="" />
      </a>
    )
  }
</div>

<style>
  .social-icons {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .social-icons a {
    display: grid;
    place-items: center;

    width: 18px;
    height: 18px;

    opacity: 0.65;

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .social-icons img {
    display: block;
    width: 100%;
    height: 100%;

    /* Simple Iconsの黒SVGを白表示 */
    filter: invert(1);
  }

  .social-icons a:hover {
    opacity: 1;
    transform: translateY(-2px);
  }

  @media (max-width: 700px) {
    .social-icons {
      gap: 9px;
    }

    .social-icons a {
      width: 15px;
      height: 15px;
    }
  }
</style>