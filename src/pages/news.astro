---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTsukinamiNews } from '../lib/bitfan';

const news = await getTsukinamiNews();
---

<BaseLayout
  title="ツキナミ NEWS｜最新情報・お知らせ"
  description="6人組アイドルグループ「ツキナミ」の最新情報・お知らせ。ライブ、イベント、リリースなどの公式NEWSをまとめています。"
>
  <main class="news-page">

    <!-- =========================
         PAGE HEADER
    ========================= -->

    <header class="page-header">
      <h1>NEWS</h1>

      <p class="page-description">
        ツキナミの最新情報・お知らせを掲載しています。
      </p>
    </header>

    <!-- =========================
         NEWS LIST
    ========================= -->

    <div class="news-list">
      {
        news.map((item) => (
          <article class="news-item">

            <!-- =========================
                 DATE
            ========================= -->

            <p class="news-date">
              {item.date}
            </p>

            <!-- =========================
                 CONTENT
            ========================= -->

            <div class="news-content">
              <h2>
                {item.title}
              </h2>

              <a
                class="news-link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                公式サイトで見る →
              </a>
            </div>

          </article>
        ))
      }
    </div>

    <!-- =========================
         EMPTY
    ========================= -->

    {
      news.length === 0 && (
        <p class="empty">
          NEWSを取得できませんでした。
        </p>
      )
    }

  </main>
</BaseLayout>

<style>
  /* =========================
     PAGE
  ========================= */

  .news-page {
    max-width: 1200px;
    margin: 0 auto;

    padding: 72px 40px 84px;
  }

  /* =========================
     PAGE HEADER
  ========================= */

  .page-header {
    margin: 0;
  }

  h1 {
    margin: 8px 0 20px;

    font-size: clamp(40px, 5vw, 64px);
    line-height: 1;
    font-weight: 600;
  }

  /* =========================
     DESCRIPTION
  ========================= */

  .page-description {
    max-width: 680px;

    margin: 0 0 32px;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.9;
  }

  /* =========================
     NEWS LIST
  ========================= */

  .news-list {
    border-top: 1px solid var(--line);
  }

  .news-item {
    display: grid;

    grid-template-columns: 130px 1fr;

    gap: 36px;

    padding: 22px 0;

    border-bottom: 1px solid var(--line);
  }

  /* =========================
     DATE
  ========================= */

  .news-date {
    margin: 0;

    color: var(--accent);

    font-size: 12px;
    line-height: 1.5;
    letter-spacing: 0.08em;
  }

  /* =========================
     CONTENT
  ========================= */

  .news-content {
    min-width: 0;
  }

  .news-content h2 {
    margin: 0;

    font-size: 17px;
    line-height: 1.5;
    font-weight: 500;
  }

  /* =========================
     OFFICIAL LINK
  ========================= */

  .news-link {
    display: inline-block;

    margin-top: 10px;
    padding-bottom: 3px;

    color: var(--muted);

    font-size: 9px;
    letter-spacing: 0.04em;

    text-decoration: none;

    border-bottom: 1px solid var(--line);
  }

  .news-link:hover {
    color: var(--accent);

    border-color: var(--accent);
  }

  /* =========================
     EMPTY
  ========================= */

  .empty {
    margin: 24px 0 0;

    color: var(--muted);

    font-size: 12px;
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 700px) {

    .news-page {
      padding: 40px 20px 52px;
    }

    /* =========================
       PAGE TITLE
    ========================= */

    h1 {
      margin: 0 0 14px;

      font-size: 32px;
    }

    /* =========================
       DESCRIPTION
    ========================= */

    .page-description {
      margin-bottom: 32px;

      font-size: 11px;
      line-height: 1.8;
    }

    /* =========================
       NEWS
    ========================= */

    .news-item {
      grid-template-columns: 1fr;

      gap: 7px;

      padding: 16px 0;
    }

    .news-date {
      font-size: 9px;
    }

    .news-content h2 {
      font-size: 13px;
      line-height: 1.5;
    }

    .news-link {
      margin-top: 7px;

      font-size: 8px;
    }
  }
</style>