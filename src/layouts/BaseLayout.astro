---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ツキナミ｜6人組アイドルグループ',
  description = '「ありふれた毎日を特別なものに。」カンナギマロが総合プロデュースを手掛ける6人組アイドルグループ「ツキナミ」の非公式ファンサイト。メンバー、ライブ・イベントスケジュール、楽曲、最新情報を掲載しています。',
} = Astro.props;

/* =========================
   SITE
========================= */

const siteName = 'ツキナミ非公式HP';

const siteUrl =
  Astro.site?.toString().replace(/\/$/, '') ??
  'https://tsukinami-site.vercel.app';

const canonicalUrl = new URL(
  Astro.url.pathname,
  siteUrl
).toString();

const ogImage =
  `${siteUrl}/images/hero/hero-group.jpg`;

/* =========================
   STRUCTURED DATA
========================= */

/*
  このWebサイトそのもの。
  非公式ファンサイトであることを明示。
*/
const websiteStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}/#website`,
  url: `${siteUrl}/`,
  name: siteName,
  description:
    '6人組アイドルグループ「ツキナミ」のメンバー、ライブ・イベント、楽曲、最新情報をまとめた非公式ファンサイト。',
  inLanguage: 'ja',
};

/*
  このサイトが扱っている対象としての
  アイドルグループ「ツキナミ」。

  WebSiteとは別の実体として定義する。
*/
const tsukinamiStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  '@id': `${siteUrl}/#tsukinami`,
  name: 'ツキナミ',
  description:
    'カンナギマロが総合プロデュースを手掛ける6人組アイドルグループ。',
  genre: 'アイドル',
};

/*
  このサイトとツキナミの関係。
*/
const webPageStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: 'ja',
  isPartOf: {
    '@id': `${siteUrl}/#website`,
  },
  about: {
    '@id': `${siteUrl}/#tsukinami`,
  },
};
---

<!doctype html>

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    
<meta name="google-site-verification" content="aX3bHY1MkedtrIGDfJ_sgeR1MbuEsg6-WBEttKTWPuU" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <!-- =========================
         TITLE
    ========================= -->

    <title>{title}</title>

    <!-- =========================
         BASIC SEO
    ========================= -->

    <meta
      name="description"
      content={description}
    />

    <link
      rel="canonical"
      href={canonicalUrl}
    />

    <!-- =========================
         FAVICON
    ========================= -->

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <!-- =========================
         PWA
    ========================= -->

    <link
      rel="manifest"
      href="/manifest.webmanifest"
    />

    <meta
      name="theme-color"
      content="#111a38"
    />

    <!-- =========================
         iPhone / iPad
    ========================= -->

    <link
      rel="apple-touch-icon"
      href="/images/tsukinami-app-icon.png"
    />

    <meta
      name="apple-mobile-web-app-capable"
      content="yes"
    />

    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />

    <meta
      name="apple-mobile-web-app-title"
      content="ツキナミ"
    />

    <!-- =========================
         OGP
    ========================= -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={title}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={canonicalUrl}
    />

    <meta
      property="og:image"
      content={ogImage}
    />

    <meta
      property="og:site_name"
      content={siteName}
    />

    <meta
      property="og:locale"
      content="ja_JP"
    />

    <!-- =========================
         X / Twitter
    ========================= -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={title}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={ogImage}
    />

    <!-- =========================
         STRUCTURED DATA
    ========================= -->

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        websiteStructuredData
      )}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        tsukinamiStructuredData
      )}
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(
        webPageStructuredData
      )}
    />
  </head>

  <body>
    <Header />

    <slot />

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #111a38;
    --text: #ffffff;
    --muted: #aeb6d3;
    --accent: #b9c2ff;
    --line: rgba(255, 255, 255, 0.16);
  }

  html,
  body {
    margin: 0;
    padding: 0;

    background: var(--bg);
    color: var(--text);
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
  }
</style>