---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ツキナミ',
  description = 'ツキナミのライブ、スケジュール、メンバー情報をまとめた非公式ファンサイト。',
} = Astro.props;

const siteUrl = 'https://tsukinami-site.vercel.app';
const ogImage = `${siteUrl}/images/hero/hero-group.jpg`;

const ogTitle = 'ツキナミ非公式HP';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />

    <title>{title}</title>

    <!-- =========================
         FAVICON
    ========================= -->

    <link
      rel="icon"
      type="image/png"
      href="/favicon.png"
    />

    <!-- =========================
         BASIC
    ========================= -->

    <meta
      name="description"
      content={description}
    />

    <!-- =========================
         PWA
    ========================= -->

    <link
      rel="manifest"
      href="/manifest.webmanifest"
    />

    <meta
      name="theme-color"
      content="#111a38"
    />

    <!-- =========================
         iPhone / iPad
    ========================= -->

    <link
      rel="apple-touch-icon"
      href="/images/tsukinami-app-icon.png"
    />

    <meta
      name="apple-mobile-web-app-capable"
      content="yes"
    />

    <meta
      name="apple-mobile-web-app-status-bar-style"
      content="default"
    />

    <meta
      name="apple-mobile-web-app-title"
      content="ツキナミ"
    />

    <!-- =========================
         OGP
    ========================= -->

    <meta
      property="og:type"
      content="website"
    />

    <meta
      property="og:title"
      content={ogTitle}
    />

    <meta
      property="og:description"
      content={description}
    />

    <meta
      property="og:url"
      content={Astro.url.href}
    />

    <meta
      property="og:image"
      content={ogImage}
    />

    <meta
      property="og:site_name"
      content="ツキナミ非公式HP"
    />

    <meta
      property="og:locale"
      content="ja_JP"
    />

    <!-- =========================
         X / Twitter
    ========================= -->

    <meta
      name="twitter:card"
      content="summary_large_image"
    />

    <meta
      name="twitter:title"
      content={ogTitle}
    />

    <meta
      name="twitter:description"
      content={description}
    />

    <meta
      name="twitter:image"
      content={ogImage}
    />
  </head>

  <body>
    <Header />

    <slot />

    <Footer />
  </body>
</html>

<style is:global>
  :root {
    --bg: #111a38;
    --text: #ffffff;
    --muted: #aeb6d3;
    --accent: #b9c2ff;
    --line: rgba(255, 255, 255, 0.16);
  }

  html,
  body {
    margin: 0;
    padding: 0;

    background: var(--bg);
    color: var(--text);
  }

  * {
    box-sizing: border-box;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
  }

  a {
    color: inherit;
  }
</style>